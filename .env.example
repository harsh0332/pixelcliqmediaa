# Canonical origin used for canonical tags, Open Graph URLs and JSON-LD.
# No trailing slash. Set this once the production domain is live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Optional.
# While it is empty, no analytics loads and no cookie banner is shown. Once
# set, GA loads only after a visitor accepts in the cookie banner.
NEXT_PUBLIC_GA_ID=
